  background: #202025;
}

.code-snippet-box {
  background: #09090b;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 16px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: #e4e4e7;
  overflow-x: auto;
  margin-top: 12px;
  line-height: 1.5;
}

/* ===== Simulator Tabs ===== */
.simulator-tab-bar {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 10px;
  margin-bottom: 18px;
}

.sim-tab-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 500;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: var(--transition-fast);
}

.sim-tab-btn.active {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}

/* ===== Stack Matrix Grid ===== */
.stack-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.stack-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: var(--transition-fast);
}

.stack-card:hover {
  border-color: var(--border-hover);
  background: var(--bg-card-hover);
}

.stack-icon {
  width: 36px;
  height: 36px;
  object-fit: contain;
}

/* ===== Animations ===== */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ===== Responsive ===== */
@media (max-width: 640px) {
  .section {
    padding: 48px 16px;
  }
  .project-content {
    padding: 20px;
  }
}
