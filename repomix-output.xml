  color: var(--text-primary);
  margin-bottom: 10px;
}

.section-desc {
  color: var(--text-secondary);
  font-size: 0.95rem;
  max-width: 680px;
  line-height: 1.6;
}

/* ===== Command Palette (Cmd + K) ===== */
.cmd-palette-input {
  width: 100%;
  background: #09090b;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  color: #fff;
  font-family: var(--font-sans);
  font-size: 0.95rem;
  outline: none;
  margin-bottom: 16px;
